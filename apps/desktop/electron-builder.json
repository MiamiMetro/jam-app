{
    "appId": "com.jam.desktop",
    "files": [
        "dist-electron",
        "dist-react",
        "!**/node_modules/**"
    ],
    "extraResources": [
        {
            "from": "resources/client",
            "to": "client",
            "filter": [
                "**/*"
            ]
        }
    ],
    "directories": {
        "output": "dist"
    },
    "artifactName": "jam-desktop-Setup-${version}.${ext}",
    "icon": "desktopIcon.png",
    "asar": true,
    "electronLanguages": [
        "en-US",
        "tr"
    ],
    "npmRebuild": false,
    "publish": {
        "provider": "github",
        "owner": "MiamiMetro",
        "repo": "jam-app"
    },
    "mac": {
        "target": [
            "dmg",
            "zip"
        ]
    },
    "linux": {
        "target": "AppImage",
        "category": "Audio"
    },
    "win": {
        "target": [
            {
                "target": "nsis",
                "arch": [
                    "x64"
                ]
            }
        ]
    },
    "nsis": {
        "oneClick": false,
        "allowToChangeInstallationDirectory": true,
        "createDesktopShortcut": true,
        "createStartMenuShortcut": true,
        "deleteAppDataOnUninstall": true,
        "runAfterFinish": true
    }
}
